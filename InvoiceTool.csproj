<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
    
    <!-- exe 文件在文件夹里的图标 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 版本号（改这里就会影响文件属性和程序显示） -->
  <Version>1.5.0</Version>
  <AssemblyVersion>1.5.0.0</AssemblyVersion>
  <FileVersion>1.5.0.0</FileVersion>

  <!-- 不把 Git 哈希加到产品版本后面 -->
  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  <InformationalVersion>1.5.0</InformationalVersion>

  <!-- 文件属性里显示的信息 -->
  <Product>差旅费发票汇总工具</Product>
  <AssemblyTitle>差旅费发票汇总工具</AssemblyTitle>
  <Description>差旅费发票汇总工具 - 支持 AI 识别与本地正则解析</Description>
  <Company>你的名字或公司名</Company>
  <Authors>你的名字</Authors>
  <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- 把 app.ico 嵌入到 exe 内部 -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="PDFsharp" Version="6.2.0" />
    <PackageReference Include="PDFtoImage" Version="5.0.0" />
    <!-- DPAPI 密钥加密 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>